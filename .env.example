# Copy to `.env` in this same directory — docker-compose.yml reads it
# automatically. Only needed to override the defaults baked into
# docker-compose.yml; every value below has a fallback except
# SUPABASE_ANON_KEY, which is required.

# Auth/Storage/app-data provider for the backend container — all three must
# be the SAME Postgres, so both settings below point at this repo's own
# local Supabase CLI stack (`npx supabase start`) by default, reached from
# inside the container via host.docker.internal — never point either at a
# production Supabase project for local testing.
SUPABASE_URL=http://host.docker.internal:54321
# The backend hands some URLs straight back to the browser (a signed
# upload URL, a public Storage object URL) — those need a hostname the
# browser can resolve, since host.docker.internal only works inside
# containers.
SUPABASE_PUBLIC_URL=http://localhost:54321
# Run `npx supabase status` (with the local stack started) and copy its
# ANON_KEY — there is no safe default for this one.
SUPABASE_ANON_KEY=
# Defaults to the same local Supabase CLI stack's own Postgres (see
# `npx supabase status` for its port, typically 54322). Only override if
# your local stack uses a different port.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

JWT_AUDIENCE=authenticated
JWT_ISSUER=
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Baked into the frontend bundle at build time (Vite has no runtime
# equivalent) — changing this requires `docker compose build frontend`,
# not just a restart. http://localhost:8000 assumes you open the frontend
# in a browser on the same machine running docker compose, with the
# backend's port 8000 published to the host.
VITE_API_BASE_URL=http://localhost:8000
