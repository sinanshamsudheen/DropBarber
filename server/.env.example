# Application
APP_ENV=development
APP_NAME=DropBarber API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database (Supabase PostgreSQL, async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dropbarber

# JWT (Supabase Auth — HS256 shared secret from Project Settings > API)
JWT_SECRET_KEY=change-me
JWT_AUDIENCE=authenticated
JWT_ISSUER=

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
