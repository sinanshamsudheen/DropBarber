# Application
APP_ENV=development
APP_NAME=DropBarber API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database (Supabase PostgreSQL, async driver) — must be the SAME Postgres
# instance SUPABASE_URL's Auth/Storage use below, since RLS policies and
# `on_auth_user_created` join across `auth.users`/`storage.objects` and this
# app's own tables. For local dev that's this repo's local Supabase CLI
# stack (`npx supabase start`; see `npx supabase status` for its Postgres
# port, typically 54322). Never point this at production.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth/Storage — this backend verifies access tokens via Supabase
# Auth's own JWKS endpoint (no shared JWT secret to configure) and proxies
# register/login/refresh/logout + media uploads to Supabase using the anon
# key (safe to hold server-side — never the service-role key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=change-me
JWT_AUDIENCE=authenticated
JWT_ISSUER=
# Only needed when the browser can't reach SUPABASE_URL directly (e.g. the
# Docker Compose setup, where SUPABASE_URL is host.docker.internal) — see
# Settings.supabase_public_url. Leave unset when running directly with
# `uv run`, since SUPABASE_URL above is already browser-reachable.
# SUPABASE_PUBLIC_URL=

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080
